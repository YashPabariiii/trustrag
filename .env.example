DATABASE_URL=postgresql+asyncpg://trustrag:trustrag@localhost:5432/trustrag
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

CHROMA_PERSIST_DIR=/chroma/data
CHROMA_HOST=localhost
CHROMA_PORT=8001

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Leave empty for the real Groq API; set to point at a gateway or local stub.
GROQ_BASE_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAGAS_EVAL_MODEL=llama-3.1-8b-instant

DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
QUERY_CACHE_TTL=1800

FREE_TIER_KB_LIMIT=2
FREE_TIER_DOC_LIMIT=10
FREE_TIER_QUERY_LIMIT=50

LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Sprint 5: dashboard ---
# Where the Streamlit process reaches the API. Compose overrides this with
# http://api:8000; locally the default is fine.
API_BASE_URL=http://localhost:8000
