    {
      "id": 46,
      "type": "heatmap",
      "title": "Chunks per document",
      "description": "A long tail means the chunker is splitting one document into far more pieces than the rest \u2014 usually a table-heavy PDF.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(trustrag_chunks_per_document_bucket[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-orange"
        },
        "yAxis": {
          "axisLabel": "score bucket",
          "unit": "short"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true,
          "yHistogram": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "rowsFrame": {
          "layout": "auto"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {},
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      }
    },
