{
  "uid": "trustrag-performance",
  "title": "TrustRAG \u2014 Query Performance",
  "description": "Throughput, per-stage latency, cache hit rate, stream/sync split, and whether evaluations are keeping up.",
  "tags": [
    "trustrag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 12,
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Queries / min",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(trustrag_queries_total[$__rate_interval])) * 60",
          "legendFormat": "queries/min",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Cache hit rate",
      "description": "A high rate is cheap answers; it also means fewer fresh evaluations, because a cache hit replays a scored answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(trustrag_cache_hits_total{type=\"query\"}[$__rate_interval])) / clamp_min(sum(rate(trustrag_cache_hits_total{type=\"query\"}[$__rate_interval])) + sum(rate(trustrag_cache_misses_total{type=\"query\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "hit rate",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Eval completion rate",
      "description": "Evaluation is fire-and-forget and never retried, so anything below 100% is answers that will stay unscored forever.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(trustrag_eval_runs_total{status=\"complete\"}[$__rate_interval])) / clamp_min(sum(rate(trustrag_eval_runs_total[$__rate_interval])), 0.0001)",
          "legendFormat": "complete",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
