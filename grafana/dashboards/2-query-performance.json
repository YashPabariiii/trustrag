        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (stream) (increase(trustrag_queries_total[$__rate_interval]))",
          "legendFormat": "stream={{stream}}",
          "range": false,
          "instant": true,
          "refId": "A"
