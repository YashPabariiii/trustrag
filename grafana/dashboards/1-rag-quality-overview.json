    {
      "id": 5,
      "type": "timeseries",
      "title": "All four metrics together",
      "description": "Divergence between these lines is the diagnosis: high faithfulness with low context relevance means retrieval is the problem, not the model.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(trustrag_faithfulness_score_sum[$__rate_interval])) / clamp_min(sum(rate(trustrag_faithfulness_score_count[$__rate_interval])), 1)",
          "legendFormat": "faithfulness",
          "range": true,
          "instant": false,
          "refId": "A"
        },
