    {
      "id": 6,
      "type": "row",
      "title": "Hallucination and distribution",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Hallucination rate per KB",
      "description": "Share of a KB's recent answers scoring above 0.30 hallucination. Low is good, so the bands are inverted.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "trustrag_hallucination_rate",
          "legendFormat": "{{kb_id}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "Overall RAG score distribution",
      "description": "Where the scores actually sit. A bimodal shape means two populations of question \u2014 usually answerable and unanswerable \u2014 not a mediocre average.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(trustrag_overall_rag_score_bucket[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-orange"
        },
        "yAxis": {
          "axisLabel": "score bucket",
          "unit": "short"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true,
          "yHistogram": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "rowsFrame": {
          "layout": "auto"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {},
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Low-score volume",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Flagged answers per minute, by flag",
      "description": "low_faithfulness \u00b7 low_context \u00b7 low_answer_rel \u00b7 hallucination. Which one dominates tells you which knob to turn.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (flag_type) (rate(trustrag_low_score_queries_total[$__rate_interval])) * 60",
          "legendFormat": "{{flag_type}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Flags raised (window)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (flag_type) (increase(trustrag_low_score_queries_total[$__rate_interval]))",
          "legendFormat": "{{flag_type}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
