{
  "uid": "trustrag-kb-health",
  "title": "TrustRAG \u2014 RAG Health by KB",
  "description": "Per-knowledge-base quality, what config changed and when, and whether the golden pairs still pass.",
  "tags": [
    "trustrag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "kb",
        "label": "Knowledge base",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "trustrag-prometheus"
        },
        "query": {
          "query": "label_values(trustrag_kb_avg_score, kb_id)",
          "refId": "kb"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 28,
      "type": "row",
      "title": "Per-KB quality",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 29,
      "type": "heatmap",
      "title": "Average score by knowledge base",
      "description": "Rolling average over each KB's last 50 evaluations. Rows are KBs; colour is the score.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "trustrag_kb_avg_score{kb_id=~\"$kb\", metric=\"overall\"}",
          "format": "heatmap",
          "legendFormat": "{{kb_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-orange"
        },
        "yAxis": {
          "axisLabel": "score bucket",
          "unit": "short"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true,
          "yHistogram": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "rowsFrame": {
          "layout": "auto"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {},
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "gauge",
      "title": "Hallucination rate per KB",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "trustrag_hallucination_rate{kb_id=~\"$kb\"}",
          "legendFormat": "{{kb_id}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 31,
      "type": "table",
      "title": "Every metric, every KB",
      "description": "faithfulness \u00b7 context_relevance \u00b7 answer_relevance \u00b7 overall, per knowledge base.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "trustrag_kb_avg_score{kb_id=~\"$kb\"}",
          "legendFormat": "{{kb_id}} / {{metric}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "service": true,
              "component": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 32,
      "type": "barchart",
      "title": "Low-score flags raised",
      "description": "Prometheus counts flags, it cannot name the questions that raised them.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (flag_type) (increase(trustrag_low_score_queries_total[$__rate_interval]))",
          "legendFormat": "{{flag_type}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 33,
      "type": "row",
      "title": "What changed, and did it help",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Retrieval config activations",
      "description": "Every activation and promotion. Line this up against the score trend above: that is the whole argument for the Retrieval Lab.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (kb_id, reason) (increase(trustrag_config_activations_total[$__rate_interval]))",
          "legendFormat": "{{kb_id}} / {{reason}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Test suite pass rate",
      "description": "Pass rate of the most recent run of each golden-pair suite. A step down right after a config activation is a regression.",
      "datasource": {
        "type": "prometheus",
        "uid": "trustrag-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "trustrag-prometheus"
          },
          "editorMode": "code",
          "expr": "trustrag_test_suite_pass_rate",
          "legendFormat": "{{suite_id}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 36,
      "type": "text",
      "title": "Worst performing queries",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "options": {
        "mode": "markdown",
        "content": "Prometheus stores **counts, not questions** \u2014 the per-query list this panel would show does not belong in a time-series database.\n\nThe ranked list of low-scoring questions, with their scores, flags and a one-click replay, lives in the product:\n\n**Dashboard \u2192 Eval Analytics \u2192 Worst performing queries** (<http://localhost:8501/eval_analytics>)\n\nor `GET /v1/knowledge-bases/{kb_id}/evaluations?low_score_only=true`.\n\nThe bar chart above is the Prometheus-shaped version of the same question: *which kind* of failure dominates."
      }
    }
  ]
}
